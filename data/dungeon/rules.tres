[gd_resource type="Resource" script_class="DungeonRules" format=3]

[ext_resource type="Script" path="res://scripts/core/data/dungeon_rules.gd" id="1"]

[resource]
script = ExtResource("1")
map_scene = "res://scenes/dungeon/dungeon.tscn"
anchors = Array[StringName]([&"atrium", &"spring", &"vestibule", &"cistern"])
anchor_names = Dictionary[StringName, String]({
&"atrium": "ANCHOR_ATRIUM",
&"spring": "ANCHOR_SPRING",
&"vestibule": "ANCHOR_VESTIBULE",
&"cistern": "ANCHOR_CISTERN"
})
return_room = &"school"
return_entrance = &"from_dungeon"
fall_limit = -60.0
