[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[shader_globals]

ps1_vertex_snap={
"type": "bool",
"value": true
}
ps1_snap_grid={
"type": "vec2",
"value": Vector2(427, 240)
}
ps1_affine_mapping={
"type": "bool",
"value": true
}
ps1_fog={
"type": "bool",
"value": true
}
ps1_fog_color={
"type": "color",
"value": Color(0.04, 0.045, 0.06, 1)
}
ps1_fog_near={
"type": "float",
"value": 2.0
}
ps1_fog_far={
"type": "float",
"value": 12.0
}
