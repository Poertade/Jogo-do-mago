// Material PS1 para superfícies 3D: vertex snapping, mapeamento afim de textura e névoa.
// O código fica em ps1_common.gdshaderinc, compartilhado com ps1_cutout.gdshader.
shader_type spatial;
render_mode vertex_lighting, diffuse_lambert, specular_disabled;

#include "res://scripts/render/ps1_common.gdshaderinc"
